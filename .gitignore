# DbDelta — .gitignore

# Node / npm (from claude-flow tooling)
node_modules/
package-lock.json

# Claude Code + ruflo local state
.claude/
.claude-flow/
.swarm/
.planning/
ruvector.db
ruvector.db-*

# Logs
logs/
*.log

# OS / editor
Thumbs.db
.DS_Store
*.swp
*~

# .NET build artifacts (future)
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
out/
publish/
TestResults/
coverage/
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# NuGet
*.nupkg
*.snupkg

# Rider / VS Code
.idea/
.vscode/

# WiX / installers
*.wixobj
*.wixpdb
*.msi
installer/staging/

# Local environment
.env
.env.*
*.local

# Local scratch (draft outputs from subagents, etc.)
tmp/

# Smoke-test output against live DBs (contains real schema names)
scripts/smoke/

# Parity-run output (DbDelta + Redgate scripts captured for diff analysis)
scripts/parity/

# Ruflo / agentdb local state
agentdb.rvf
agentdb.rvf-*
agentdb.rvf.lock

# DocFX generated output
docfx/api/*.yml
docfx/api/.manifest
docfx/_site/
