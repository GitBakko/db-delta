<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:v="using:DbDelta.App.Views"
        x:Class="DbDelta.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DbDelta"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}">

  <!-- App shell: 44px topbar / 56px header strip / flex middle / 24px statusbar -->
  <Grid RowDefinitions="44,56,*,24">

    <!-- ── Band 1: App topbar ─────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <!-- 0: brand -->
          <ColumnDefinition Width="Auto" />
          <!-- 1: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 2: Group A — New / Open / Save -->
          <ColumnDefinition Width="Auto" />
          <!-- 3: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 4: Group B — MRU / Edit / Refresh -->
          <ColumnDefinition Width="Auto" />
          <!-- 5: filler -->
          <ColumnDefinition Width="*" />
          <!-- 6: Cerca TextBox -->
          <ColumnDefinition Width="220" />
          <!-- 7: Raggruppa per ComboBox -->
          <ColumnDefinition Width="Auto" />
          <!-- 8: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 9: theme toggle -->
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 0: brand stack -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0">
          <Border Width="22" Height="22"
                  Background="{StaticResource PrimaryBrush}"
                  CornerRadius="5">
            <Path Stroke="{StaticResource PrimaryFgBrush}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M 6,16 L 11,5 L 16,16 Z M 8.5,16 L 8.5,10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DbDelta"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Version}"
                     FontSize="11"
                     Foreground="{StaticResource FgSubtleBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 1: divider -->
        <Border Grid.Column="1" Classes="topbar-divider" />

        <!-- 2: Group A — Nuovo / Carica / Salva -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">

          <!-- Nuovo progetto — file-plus icon, same fixed-container trick as
               "Carica" so the icon sits on the same optical baseline as the
               text label regardless of Stretch=Uniform aspect-fit. -->
          <Button Classes="ghost"
                  Command="{Binding NewProjectCommand}"
                  ToolTip.Tip="Crea un nuovo progetto DbDelta"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 12,12 L 12,18 M 9,15 L 15,15" />
              </Border>
              <TextBlock Text="Nuovo" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Carica progetto — folder icon wrapped in a fixed 16-px container
               so layout doesn't drift with Path Stretch=Uniform, then nudged
               down 1 px to align with the text's optical centre (text x-height
               sits above the layout-box centre, so a raw center alignment looks
               icon-low; pushing it down a hair restores symmetry). -->
          <Button Classes="ghost"
                  Command="{Binding OpenProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Carica un progetto DbDelta esistente"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 2,6 L 9,6 L 11,8 L 22,8 L 22,18 L 2,18 Z" />
              </Border>
              <TextBlock Text="Carica" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Salva progetto — same icon-container alignment fix -->
          <Button Classes="ghost"
                  Command="{Binding SaveProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Salva il progetto corrente"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 5,5 L 17,5 L 19,7 L 19,19 L 5,19 Z M 7,5 L 7,11 L 15,11 L 15,5 M 9,15 L 15,15" />
              </Border>
              <TextBlock Text="Salva" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

        </StackPanel>

        <!-- 3: divider -->
        <Border Grid.Column="3" Classes="topbar-divider" />

        <!-- 4: Group B — I miei progetti / Modifica / Refresh -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">

          <!-- I miei progetti (MRU drop-down) -->
          <ComboBox ItemsSource="{Binding ProjectMru}"
                    PlaceholderText="I miei progetti"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Carica un progetto recente"
                    FontSize="12" />

          <!-- Modifica progetto -->
          <Button Classes="ghost"
                  Command="{Binding EditProjectCommand}"
                  ToolTip.Tip="Modifica il progetto corrente"
                  Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="14" Height="14" Stretch="Uniform"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Fill="Transparent"
                    Data="M 15,5 L 19,9 L 9,19 L 5,19 L 5,15 Z M 13,7 L 17,11" />
              <TextBlock Text="Modifica" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Refresh -->
          <Button Classes="ghost"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Riesegui il confronto"
                  Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="14" Height="14" Stretch="Uniform"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Fill="Transparent"
                    Data="M 20,12 A 8,8 0 1 1 18,7 M 18,4 L 18,8 L 14,8" />
              <TextBlock Text="Aggiorna" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

        </StackPanel>

        <!-- 5: filler -->

        <!-- 6: Cerca TextBox -->
        <Border Grid.Column="6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{StaticResource BgBrush}"
                VerticalAlignment="Center"
                Margin="0,0,6,0">
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  Stroke="{StaticResource FgSubtleBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  Margin="8,0,4,0"
                  Data="M 11,5 A 6,6 0 1 1 10.99,5 M 16,16 L 20,20" />
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Cerca in tutti i campi…"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4,6"
                     VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- 7: Raggruppa per ComboBox -->
        <ComboBox Grid.Column="7"
                  ItemsSource="{Binding GroupingOptions}"
                  SelectedItem="{Binding GroupingMode, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  MinWidth="180"
                  FontSize="12"
                  ToolTip.Tip="Raggruppa i risultati per criterio" />

        <!-- 8: divider -->
        <Border Grid.Column="8" Classes="topbar-divider" />

        <!-- 9: theme toggle -->
        <Button Grid.Column="9"
                Classes="ghost"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Tema chiaro / scuro"
                VerticalAlignment="Center">
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.6"
                StrokeLineCap="Round"
                Data="M 12,4 A 8,8 0 1 0 20,12 A 6,6 0 0 1 12,4 Z" />
        </Button>

      </Grid>
    </Border>

    <!-- ── Band 2: Project header strip — only after a project is loaded ──── -->
    <Border Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">
      <v:ProjectHeaderStrip DataContext="{Binding}" />
    </Border>

    <!-- ── Band 3: Middle ─ welcome overlay OR populated body ──────────────── -->
    <Panel Grid.Row="2">

      <!-- Welcome state: no project loaded yet -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNull}}">
        <Border Width="64" Height="64"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="14"
                HorizontalAlignment="Center">
          <Path Stroke="{StaticResource PrimaryFgBrush}"
                StrokeThickness="2.4"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Data="M 18,46 L 32,16 L 46,46 Z M 24,46 L 24,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Benvenuto in DbDelta"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FgStrongBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Crea un nuovo progetto o caricane uno esistente per iniziare."
                   FontSize="13"
                   Foreground="{StaticResource FgMutedBrush}"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Populated state: project loaded, comparison ran -->
      <Grid RowDefinitions="Auto,*,Auto"
            IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">

        <!-- Action bar: counter + per-type badges + Genera script + Allinea destinazione -->
        <Border Grid.Row="0"
                Background="{StaticResource BgMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectionSummary}"
                       FontSize="12"
                       Foreground="{StaticResource FgMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <!-- Status badges: pill with status colour + count, white text -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Background="#0064C8" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsModifiedCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsModifiedCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="modificate" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#B31220" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsOnlyDestCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsOnlyDestCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="solo destinazione" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#007339" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsOnlyProvCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsOnlyProvCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="solo provenienza" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#9097A0" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding IdenticalsCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding IdenticalsCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="identiche" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Button Grid.Column="3" Classes="ghost-emerald"
                    Command="{Binding DeployCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Genera script SQL di allineamento per le righe selezionate"
                    Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 9,14 L 16,14 M 9,17 L 16,17" />
                <TextBlock Text="Genera script" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="primary"
                    Command="{Binding ExecuteOnTargetCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Esegui lo script di allineamento direttamente sulla destinazione">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Fill="{StaticResource PrimaryFgBrush}"
                      Data="M 5,4 L 19,12 L 5,20 Z" />
                <TextBlock Text="Allinea destinazione" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryFgBrush}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Results grid takes ALL remaining space -->
        <v:ResultsGridView Grid.Row="1"
                           DataContext="{Binding}" />

        <!-- Diff viewer — collapsible auto row, only takes space when shown.
             Identical rows produce no diff so the pane stays collapsed even
             when a row is selected (driven by ShouldShowDiffViewer). -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,8,0,0"
                Height="280"
                IsVisible="{Binding AppState.ShouldShowDiffViewer}">
          <v:DiffViewerView DataContext="{Binding AppState.DiffViewer}" />
        </Border>
      </Grid>

    </Panel>

    <!-- Status bar -->
    <Border Grid.Row="3"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding AppState.StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource FgSubtleBrush}" />
        <TextBlock Text="·" Foreground="{StaticResource BorderStrongBrush}" FontSize="11" />
        <TextBlock Text="{Binding AppState.SourceConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                   FontSize="11"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Foreground="{StaticResource FgSubtleBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="500" />
        <TextBlock Text="→" Foreground="{StaticResource FgFaintBrush}" FontSize="11" />
        <TextBlock Text="{Binding AppState.TargetConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                   FontSize="11"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Foreground="{StaticResource FgSubtleBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="500" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
