<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:v="using:DbDelta.App.Views"
        x:Class="DbDelta.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DbDelta"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}">

  <!-- App shell: 44px topbar / flex middle / 24px statusbar -->
  <Grid RowDefinitions="44,*,24">

    <!-- Topbar -->
    <Border Grid.Row="0"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="12,0">

        <!-- 0: sidebar toggle -->
        <Button Grid.Column="0"
                Classes="ghost"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="Mostra/nascondi pannello laterale"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
          <Panel Width="16" Height="16">
            <Path Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent"
                  IsVisible="{Binding IsSidebarOpen}"
                  Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 9,5 L 9,19 M 16,9 L 13,12 L 16,15" />
            <Path Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent"
                  IsVisible="{Binding !IsSidebarOpen}"
                  Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 9,5 L 9,19 M 13,9 L 16,12 L 13,15" />
          </Panel>
        </Button>

        <!-- 1: brand stack -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Border Width="22" Height="22"
                  Background="{StaticResource PrimaryBrush}"
                  CornerRadius="5">
            <Path Stroke="{StaticResource PrimaryFgBrush}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M 6,16 L 11,5 L 16,16 Z M 8.5,16 L 8.5,10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DbDelta"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Version}"
                     FontSize="11"
                     Foreground="{StaticResource FgSubtleBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 2: spacer * -->

        <!-- 3: Apri progetto -->
        <Button Grid.Column="3"
                Classes="ghost"
                Command="{Binding OpenProjectCommand}"
                CommandParameter="{Binding $parent[Window]}"
                ToolTip.Tip="Apri un progetto DbDelta esistente"
                VerticalAlignment="Center"
                Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 4,7 L 4,18 L 20,18 L 20,9 L 12,9 L 10,7 Z" />
            <TextBlock Text="Apri" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- 4: Salva progetto -->
        <Button Grid.Column="4"
                Classes="ghost"
                Command="{Binding SaveProjectCommand}"
                CommandParameter="{Binding $parent[Window]}"
                ToolTip.Tip="Salva il progetto corrente"
                VerticalAlignment="Center"
                Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 5,5 L 17,5 L 19,7 L 19,19 L 5,19 Z M 7,5 L 7,11 L 15,11 L 15,5 M 9,15 L 15,15" />
            <TextBlock Text="Salva" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- 5: Connessioni — opens centralised manager -->
        <Button Grid.Column="5"
                Classes="ghost"
                Command="{Binding OpenConnectionManagerCommand}"
                CommandParameter="{Binding $parent[Window]}"
                ToolTip.Tip="Gestisci connessioni salvate"
                VerticalAlignment="Center"
                Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
            <TextBlock Text="Connessioni" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- 6: divider -->
        <Border Grid.Column="6" Classes="topbar-divider" />

        <!-- 7: theme toggle — icon-only (system affordance, not an app-menu item) -->
        <Button Grid.Column="7"
                Classes="ghost"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Tema chiaro / scuro"
                VerticalAlignment="Center">
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.6"
                StrokeLineCap="Round"
                Data="M 12,4 A 8,8 0 1 0 20,12 A 6,6 0 0 1 12,4 Z" />
        </Button>

      </Grid>
    </Border>

    <!-- Middle: sidebar column (collapsible) + 1fr main -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding SidebarWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource BgSubtleBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0"
              IsVisible="{Binding IsSidebarOpen}">
        <v:RecentConnectionsSidebar DataContext="{Binding AppState.Connections}" />
      </Border>

      <!-- Main: 2-row grid lets ConnectionPicker keep its natural height
           while ResultsTree expands to fill all remaining vertical space. -->
      <Grid Grid.Column="1"
            RowDefinitions="Auto,*"
            Margin="24">
        <v:ConnectionPickerView Grid.Row="0"
                                DataContext="{Binding AppState}"
                                Margin="0,0,0,16" />
        <v:ResultsTreeView Grid.Row="1"
                          DataContext="{Binding AppState}" />
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding AppState.StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource FgSubtleBrush}" />
        <TextBlock Text="·" Foreground="{StaticResource BorderStrongBrush}" FontSize="11" />
        <TextBlock Text="{Binding AppState.SourceConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                   FontSize="11"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Foreground="{StaticResource FgSubtleBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="500" />
        <TextBlock Text="→" Foreground="{StaticResource FgFaintBrush}" FontSize="11" />
        <TextBlock Text="{Binding AppState.TargetConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                   FontSize="11"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   Foreground="{StaticResource FgSubtleBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="500" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
