<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:v="using:DbDelta.App.Views"
        xmlns:c="using:DbDelta.App.Views.Controls"
        xmlns:json="using:DbDelta.Persistence.Json"
        x:Class="DbDelta.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DbDelta"
        Icon="/Assets/app-icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}">

  <!-- Root: shell content + full-window busy overlay. ClipToBounds
       prevents any inner control's padding/border rounding artefact from
       triggering a stray horizontal scrollbar on the window. -->
  <Panel ClipToBounds="True">

  <!-- App shell: 44px topbar / 56px header strip / error band / stale band /
       flex middle / 24px statusbar. Both bands are Auto and collapse to zero
       height when their notice is not showing. -->
  <Grid RowDefinitions="44,56,Auto,Auto,Auto,*,24">

    <!-- ── Band 1: App topbar ─────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <!-- 0: brand -->
          <ColumnDefinition Width="Auto" />
          <!-- 1: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 2: Group A — New / Open / Save -->
          <ColumnDefinition Width="Auto" />
          <!-- 3: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 4: Group B — MRU / Edit / Refresh -->
          <ColumnDefinition Width="Auto" />
          <!-- 5: filler -->
          <ColumnDefinition Width="*" />
          <!-- 6: Cerca TextBox -->
          <ColumnDefinition Width="220" />
          <!-- 7: Raggruppa per ComboBox -->
          <ColumnDefinition Width="Auto" />
          <!-- 8: divider -->
          <ColumnDefinition Width="Auto" />
          <!-- 9: theme toggle -->
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 0: brand stack -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0">
          <Border Width="22" Height="22"
                  Background="{StaticResource PrimaryBrush}"
                  CornerRadius="5">
            <Path Stroke="{StaticResource PrimaryFgBrush}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M 6,16 L 11,5 L 16,16 Z M 8.5,16 L 8.5,10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DbDelta"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding AppVersion}"
                     FontSize="11"
                     Foreground="{StaticResource FgSubtleBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 1: divider -->
        <Border Grid.Column="1" Classes="topbar-divider" />

        <!-- 2: Group A — Nuovo / Carica / Salva -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">

          <!-- Nuovo progetto — file-plus icon, same fixed-container trick as
               "Carica" so the icon sits on the same optical baseline as the
               text label regardless of Stretch=Uniform aspect-fit. -->
          <Button Classes="ghost"
                  Command="{Binding NewProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Crea un nuovo progetto DbDelta"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 12,12 L 12,18 M 9,15 L 15,15" />
              </Border>
              <TextBlock Text="Nuovo" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Carica progetto — folder icon wrapped in a fixed 16-px container
               so layout doesn't drift with Path Stretch=Uniform, then nudged
               down 1 px to align with the text's optical centre (text x-height
               sits above the layout-box centre, so a raw center alignment looks
               icon-low; pushing it down a hair restores symmetry). -->
          <Button Classes="ghost"
                  Command="{Binding OpenProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Carica un progetto DbDelta esistente"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 2,6 L 9,6 L 11,8 L 22,8 L 22,18 L 2,18 Z" />
              </Border>
              <TextBlock Text="Carica" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Salva progetto — same icon-container alignment fix -->
          <Button Classes="ghost"
                  Command="{Binding SaveProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Salva il progetto corrente"
                  Padding="6"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,0,0">
                <Path Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 5,5 L 17,5 L 19,7 L 19,19 L 5,19 Z M 7,5 L 7,11 L 15,11 L 15,5 M 9,15 L 15,15" />
              </Border>
              <TextBlock Text="Salva" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

        </StackPanel>

        <!-- 3: divider -->
        <Border Grid.Column="3" Classes="topbar-divider" />

        <!-- 4: Group B — I miei progetti / Modifica / Refresh -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">

          <!-- I miei progetti (MRU drop-down) — each entry shows filename +
               save-date; selection fires OpenRecent with (Window, Path)
               tuple so the VM re-routes through LoadProjectFromPathAsync -->
          <ComboBox x:Name="ProjectMruCombo"
                    ItemsSource="{Binding ProjectMru}"
                    PlaceholderText="I miei progetti"
                    MinWidth="240"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Carica un progetto recente"
                    FontSize="12"
                    SelectionChanged="OnProjectMruSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="json:RecentProject">
                <Grid ColumnDefinitions="*,Auto" Margin="2,2">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Path, Converter={x:Static v:Converters.PathToFileName}}"
                             ToolTip.Tip="{Binding Path}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource FgStrongBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding LastUsedUtc, Converter={x:Static v:Converters.DateToItalianLocal}}"
                             Margin="12,0,0,0"
                             FontSize="10"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             Foreground="{StaticResource FgSubtleBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Modifica progetto -->
          <Button Classes="ghost"
                  Command="{Binding EditProjectCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  ToolTip.Tip="Modifica il progetto corrente"
                  Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="14" Height="14" Stretch="Uniform"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Fill="Transparent"
                    Data="M 15,5 L 19,9 L 9,19 L 5,19 L 5,15 Z M 13,7 L 17,11" />
              <TextBlock Text="Modifica" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

          <!-- Refresh -->
          <Button Classes="ghost"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Riesegui il confronto"
                  Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="14" Height="14" Stretch="Uniform"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Fill="Transparent"
                    Data="M 20,12 A 8,8 0 1 1 18,7 M 18,4 L 18,8 L 14,8" />
              <TextBlock Text="Aggiorna" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>

        </StackPanel>

        <!-- 5: filler -->

        <!-- 6: Cerca TextBox -->
        <Border Grid.Column="6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{StaticResource BgBrush}"
                VerticalAlignment="Center"
                Margin="0,0,6,0">
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0"
                  Width="14" Height="14"
                  Stretch="Uniform"
                  Stroke="{StaticResource FgSubtleBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  Margin="8,0,4,0"
                  Data="M 11,5 A 6,6 0 1 1 10.99,5 M 16,16 L 20,20" />
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Cerca in tutti i campi…"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4,6"
                     VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- 7: Raggruppa per ComboBox -->
        <ComboBox Grid.Column="7"
                  ItemsSource="{Binding GroupingOptions}"
                  SelectedItem="{Binding GroupingMode, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  MinWidth="180"
                  FontSize="12"
                  ToolTip.Tip="Raggruppa i risultati per criterio" />

        <!-- 8: divider -->
        <Border Grid.Column="8" Classes="topbar-divider" />

        <!-- 9: theme cycle — Chiaro → Scuro → Sistema → Chiaro. The icon shows
             the state the app is IN, and the tooltip names it; with three
             states an "invites the next state" icon stops being readable. -->
        <Button Grid.Column="9"
                Classes="ghost"
                Command="{Binding CycleThemeCommand}"
                ToolTip.Tip="{Binding ThemeTooltip}"
                VerticalAlignment="Center">
          <Panel>
            <!-- Sun icon — pinned to light -->
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round"
                  Fill="Transparent"
                  IsVisible="{Binding IsThemeLight}"
                  Data="M 12,5 A 7,7 0 1 1 11.99,5 M 12,1 L 12,3 M 12,21 L 12,23 M 4.2,4.2 L 5.6,5.6 M 18.4,18.4 L 19.8,19.8 M 1,12 L 3,12 M 21,12 L 23,12 M 4.2,19.8 L 5.6,18.4 M 18.4,5.6 L 19.8,4.2" />
            <!-- Moon icon — pinned to dark -->
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round"
                  Fill="Transparent"
                  IsVisible="{Binding IsThemeDark}"
                  Data="M 12,4 A 8,8 0 1 0 20,12 A 6,6 0 0 1 12,4 Z" />
            <!-- Monitor icon — following the operating system -->
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round"
                  Fill="Transparent"
                  IsVisible="{Binding IsThemeSystem}"
                  Data="M 3,5 L 21,5 L 21,16 L 3,16 Z M 9,20 L 15,20 M 12,16 L 12,20" />
          </Panel>
        </Button>

      </Grid>
    </Border>

    <!-- ── Band 2: Project header strip — only after a project is loaded ──── -->
    <Border Grid.Row="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">
      <v:ProjectHeaderStrip DataContext="{Binding}" />
    </Border>

    <!-- ── Band 3: Error banner ─────────────────────────────────────────────
         AppState.LastError was previously bound ONLY in ConnectionPickerView,
         which is never instantiated — so every failed compare / project load
         set the message and nobody ever saw it. The grid kept showing the
         PREVIOUS run's counts, which the user then read as current. Auto row:
         collapses to zero height while there is no error. -->
    <c:NoticeBand Grid.Row="2"
                  Accent="{StaticResource DangerBrush}"
                  AccentSoft="{StaticResource DangerSoftBrush}"
                  AccentForeground="{StaticResource DangerFgBrush}"
                  IconPath="M 8,1 L 15,14 L 1,14 Z M 8,6 L 8,10 M 8,11.6 L 8,12.4"
                  Message="{Binding AppState.LastError}"
                  IsVisible="{Binding AppState.LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <c:NoticeBand.Trailing>
        <Button Content="Chiudi"
                Command="{Binding DismissErrorCommand}"
                Height="32"
                Padding="12,0"
                Margin="12,0,0,0"
                Background="{StaticResource BgRaisedBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                Foreground="{StaticResource FgStrongBrush}"
                FontSize="12"
                VerticalAlignment="Center" />
      </c:NoticeBand.Trailing>
    </c:NoticeBand>

    <!-- ── Band 3b: Stale results ───────────────────────────────────────────
         The rows below are not backed by a comparison that completed against
         the endpoints now configured, so they must not read as current. That
         covers a repointed endpoint AND a refresh that failed against the very
         same one, which is the commoner case — so the wording claims nothing
         about the connections themselves. Both Salva and Esegui are disabled
         while this shows — see AppStateViewModel.ResultsAreStale. No dismiss
         button: the only way out is to compare again. -->
    <c:NoticeBand Grid.Row="3"
                  Accent="{StaticResource WarningBrush}"
                  AccentSoft="{StaticResource WarningSoftBrush}"
                  AccentForeground="{StaticResource WarningFgBrush}"
                  IconPath="M 8,1 A 7,7 0 1 1 7.99,1 M 8,4.4 L 8,8.6 M 8,10.6 L 8,11.4"
                  Message="Questi risultati provengono da un confronto precedente e non sono stati verificati sulle connessioni configurate ora. Esegui di nuovo il confronto prima di generare o applicare uno script."
                  IsVisible="{Binding ResultsAreStale}" />

    <!-- ── Band 3c: Scope of the verdict ────────────────────────────────────
         "Nessuna differenza" means none among the thirteen kinds DbDelta models,
         and nothing used to say so. The silent case is the dangerous one: a table
         missing its clustered columnstore index compares Identical, because
         IndexReader filters to type IN (1,2) on BOTH sides and neither ever
         mentions it. Auto row, so it collapses when the endpoints hold nothing
         outside those kinds. No dismiss button — it describes the results below
         and disappears with them. -->
    <c:NoticeBand Grid.Row="4"
                  x:Name="ScopeBand"
                  Accent="{StaticResource WarningBrush}"
                  AccentSoft="{StaticResource WarningSoftBrush}"
                  AccentForeground="{StaticResource WarningFgBrush}"
                  IconPath="M 8,1 A 7,7 0 1 1 7.99,1 M 8,4.4 L 8,8.6 M 8,10.6 L 8,11.4"
                  Message="{Binding AppState.UnexaminedSummary}"
                  IsVisible="{Binding AppState.UnexaminedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- ── Band 4: Middle ─ welcome overlay OR populated body ──────────────── -->
    <Panel Grid.Row="5">

      <!-- Welcome state: no project loaded yet -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12"
                  IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNull}}">
        <Border Width="64" Height="64"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="14"
                HorizontalAlignment="Center">
          <Path Stroke="{StaticResource PrimaryFgBrush}"
                StrokeThickness="2.4"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Data="M 18,46 L 32,16 L 46,46 Z M 24,46 L 24,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Benvenuto in DbDelta"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FgStrongBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Crea un nuovo progetto o caricane uno esistente per iniziare."
                   FontSize="13"
                   Foreground="{StaticResource FgMutedBrush}"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Populated state: project loaded, comparison ran -->
      <Grid RowDefinitions="Auto,*,Auto"
            IsVisible="{Binding AppState.LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">

        <!-- Action bar: counter + per-type badges + Genera script + Allinea destinazione -->
        <Border Grid.Row="0"
                Background="{StaticResource BgMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectionSummary}"
                       FontSize="12"
                       Foreground="{StaticResource FgMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <!-- Status badges: pill with status colour + count, white text -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Background="#0064C8" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsModifiedCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsModifiedCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="modificate" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#B31220" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsOnlyDestCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsOnlyDestCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="solo destinazione" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#007339" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding DiffsOnlyProvCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding DiffsOnlyProvCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="solo provenienza" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#9097A0" CornerRadius="10" Padding="8,2"
                      IsVisible="{Binding IdenticalsCount, Converter={x:Static v:Converters.IsPositive}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding IdenticalsCount}" FontSize="11" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center" />
                  <TextBlock Text="identiche" FontSize="11" Foreground="White"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Neutral, not emerald: saving the record of a comparison is a
                 utility action, while Genera script is the read-only success
                 path. It covers the whole comparison, so it needs no selection
                 and stays enabled when nothing is ticked. -->
            <Button Grid.Column="3" Classes="ghost"
                    Command="{Binding SaveReportCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Salva il report HTML dell'intero confronto (non solo delle righe selezionate)"
                    Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 4,20 L 20,20 M 7,20 L 7,12 M 12,20 L 12,5 M 17,20 L 17,9" />
                <TextBlock Text="Salva report" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="ghost-emerald"
                    Command="{Binding DeployCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Genera script SQL di allineamento per le righe selezionate"
                    Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent"
                      Data="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 9,14 L 16,14 M 9,17 L 16,17" />
                <TextBlock Text="Genera script" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="primary"
                    Command="{Binding ExecuteOnTargetCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    ToolTip.Tip="Esegui lo script di allineamento direttamente sulla destinazione">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Fill="{StaticResource PrimaryFgBrush}"
                      Data="M 5,4 L 19,12 L 5,20 Z" />
                <TextBlock Text="Allinea destinazione" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryFgBrush}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Results grid takes ALL remaining space -->
        <v:ResultsGridView Grid.Row="1"
                           DataContext="{Binding}" />

        <!-- Diff viewer — collapsible auto row, only takes space when shown.
             Identical rows produce no diff so the pane stays collapsed even
             when a row is selected (driven by ShouldShowDiffViewer). -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,8,0,0"
                Height="280"
                IsVisible="{Binding AppState.ShouldShowDiffViewer}">
          <v:DiffViewerView DataContext="{Binding AppState.DiffViewer}" />
        </Border>
      </Grid>

    </Panel>

    <!-- Status bar. ClipToBounds suppresses any minor pixel overflow from
         the redacted connection strings that previously bubbled up into a
         stray window-level horizontal scrollbar. -->
    <Border Grid.Row="6"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            ClipToBounds="True">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    HorizontalAlignment="Left">
          <!-- MainWindowViewModel.StatusText, NOT AppState.StatusText: the
               latter is computed ("Ready" / "Working…") and the busy overlay
               already shows it, while the writable one carries the outcome of
               save / deploy / execute — which was bound nowhere, so those
               messages were written and never displayed. -->
          <TextBlock Text="{Binding StatusText}"
                     FontSize="11"
                     Foreground="{StaticResource FgSubtleBrush}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="560" />
          <TextBlock Text="·" Foreground="{StaticResource BorderStrongBrush}" FontSize="11" />
          <TextBlock Text="{Binding AppState.SourceConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                     FontSize="11"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Foreground="{StaticResource FgSubtleBrush}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="500" />
          <TextBlock Text="→" Foreground="{StaticResource FgFaintBrush}" FontSize="11" />
          <TextBlock Text="{Binding AppState.TargetConnectionString, Converter={x:Static v:Converters.RedactConnectionString}}"
                     FontSize="11"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Foreground="{StaticResource FgSubtleBrush}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="500" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <!-- Last-run pill. Appears only once something has run, and stays
               until the next one: the execute dialog's outcome panel dies with
               the dialog, taking every error the server raised with it. Click
               opens the whole transcript. -->
          <Button Classes="status-pill"
                  Content="{Binding LastRun.PillLabel}"
                  Command="{Binding ShowLastRunCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  IsVisible="{Binding LastRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Foreground="{Binding LastRun.Succeeded,
                                       Converter={x:Static v:Converters.RunOutcomeBrush}}"
                  ToolTip.Tip="Apri i messaggi del server per l'ultima esecuzione"
                  VerticalAlignment="Center" />
          <Button Classes="status-pill"
                  Content="{Binding AppVersion}"
                  Command="{Binding OpenVersionHistoryCommand}"
                  ToolTip.Tip="Apri la version history nel browser"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>

  <!-- Busy overlay — covers the whole window while a compare/load is in
       flight so the user can't trigger destructive follow-up actions while
       the grid is still rebuilding. -->
  <Border IsVisible="{Binding AppState.IsBusy}"
          Background="#80000000"
          ZIndex="100">
    <Border Background="{StaticResource BgRaisedBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Orientation="Vertical" Spacing="14" MinWidth="280">
        <TextBlock Text="Operazione in corso…"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FgStrongBrush}"
                   HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True"
                     Height="6"
                     MinWidth="240"
                     Foreground="{StaticResource PrimaryBrush}"
                     Background="{StaticResource PrimarySoftBrush}"
                     ShowProgressText="False" />
        <TextBlock Text="{Binding AppState.StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource FgSubtleBrush}"
                   HorizontalAlignment="Center" />
        <!-- The only way out of a compare against a server that stopped
             answering. Neutral (ghost = raised fill) per UI rule 1: aborting a
             read-only operation destroys nothing. -->
        <Button Classes="ghost"
                Command="{Binding AppState.CompareCancelCommand}"
                HorizontalAlignment="Center"
                ToolTip.Tip="Interrompe la lettura dei cataloghi">
          <TextBlock Text="Annulla" />
        </Button>
      </StackPanel>
    </Border>
  </Border>

  </Panel>

</Window>
