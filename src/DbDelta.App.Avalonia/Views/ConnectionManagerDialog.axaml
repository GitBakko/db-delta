<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:core="using:DbDelta.Core.Abstractions"
        x:Class="DbDelta.App.Views.ConnectionManagerDialog"
        x:DataType="vm:ConnectionStoreViewModel"
        Title="Gestione connessioni"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <!-- Toolbar: search + Nuova -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Cerca per nome, server, database o tag…" />
      <Button Grid.Column="1" Classes="ghost-violet" Margin="8,0,0,0"
              Click="OnNewClick">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.8" StrokeLineCap="Round"
                Data="M 12,5 L 12,19 M 5,12 L 19,12" />
          <TextBlock Text="Nuova" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- List -->
    <Border Grid.Row="1" Classes="surface-raised" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding FilteredEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="core:ConnectionEntry">
              <Grid ColumnDefinitions="6,*,Auto" Margin="0,1" MinHeight="44">
                <Border Grid.Column="0">
                  <Border.Background>
                    <SolidColorBrush Color="{Binding EnvironmentColorHex}" />
                  </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium"
                               Foreground="{StaticResource FgStrongBrush}" />
                    <Border CornerRadius="3" Padding="6,1">
                      <Border.Background>
                        <SolidColorBrush Color="{Binding EnvironmentColorHex}" />
                      </Border.Background>
                      <TextBlock Text="{Binding EnvironmentTag}"
                                 FontSize="10" Foreground="White" />
                    </Border>
                    <TextBlock Text="&#x1F4CC;" IsVisible="{Binding IsPinned}" FontSize="10" />
                  </StackPanel>
                  <TextBlock FontSize="11" Foreground="{StaticResource FgSubtleBrush}">
                    <Run Text="{Binding ServerName}" />
                    <Run Text=" / " />
                    <Run Text="{Binding DatabaseName}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Button Classes="ghost-amber" Tag="{Binding Id}" Click="OnEditClick"
                          ToolTip.Tip="Modifica">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Width="14" Height="14" Stretch="Uniform"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                            Data="M 4,20 L 8,20 L 18,10 L 14,6 L 4,16 Z M 13,7 L 17,11" />
                      <TextBlock Text="Modifica" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost-crimson" Tag="{Binding Id}" Click="OnDeleteClick"
                          ToolTip.Tip="Elimina">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Width="14" Height="14" Stretch="Uniform"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="1.7" StrokeLineCap="Round"
                            Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 6,7 L 7,20 L 17,20 L 18,7 M 10,11 L 10,17 M 14,11 L 14,17" />
                      <TextBlock Text="Elimina" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Close -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Classes="ghost" Click="OnCloseClick">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.8" StrokeLineCap="Round"
                Data="M 6,6 L 18,18 M 6,18 L 18,6" />
          <TextBlock Text="Chiudi" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

  </Grid>
</Window>
