<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbDelta.App.Views.ConfirmDialog"
        Title="Conferma"
        Icon="/Assets/app-icon.png"
        Width="460" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BgBrush}">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Center">
      <TextBlock x:Name="HeadlineText"
                 Text=""
                 FontWeight="SemiBold" FontSize="14"
                 Foreground="{StaticResource FgStrongBrush}"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="BodyText"
                 Text=""
                 FontSize="12"
                 Foreground="{StaticResource FgMutedBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Classes="ghost" IsCancel="True" Click="OnCancelClick">
        <TextBlock Text="Annulla" />
      </Button>
      <Button x:Name="ConfirmButton" Classes="solid-crimson" Click="OnConfirmClick">
        <TextBlock x:Name="ConfirmLabel" Text="Continua" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
