<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:v="using:DbDelta.App.Views"
        xmlns:sql="using:DbDelta.Persistence.Sql"
        x:Class="DbDelta.App.Views.ProjectSetupDialog"
        x:DataType="vm:ProjectSetupViewModel"
        Title="Nuovo progetto"
        Width="1180" Height="560"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BgBrush}">

  <Grid RowDefinitions="*,Auto">

    <!-- ── Body: data-sources content directly (no tabs) ─────────────────── -->
    <Grid Grid.Row="0" RowDefinitions="Auto,*">

      <!-- Source / Target band -->
      <Grid Grid.Row="0" ColumnDefinitions="*,*" Height="80">

        <!-- Source half -->
        <Border Grid.Column="0" Background="{StaticResource BgMutedBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8">
            <!-- DB cylinder icon — stroke colour driven by SQL Server version -->
            <Path Grid.Column="0"
                  Width="28" Height="28" Stretch="Uniform"
                  Stroke="{Binding Source.ServerMajorVersion, Converter={x:Static v:Converters.MajorVersionToBrush}}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent" VerticalAlignment="Center"
                  Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Provenienza" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource FgSubtleBrush}" />
              <TextBlock Text="{Binding Source.DisplayBandName}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource FgStrongBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Source.DatabaseName}" FontSize="12"
                         Foreground="{StaticResource FgMutedBrush}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Source.DatabaseName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <!-- Version label bottom-right -->
            <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Bottom"
                       Foreground="{StaticResource FgSubtleBrush}"
                       Text="{Binding Source.ServerVersion}"
                       IsVisible="{Binding Source.ServerVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Right" Margin="0,0,0,4" />
          </Grid>
        </Border>

        <!-- Target half -->
        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8">
            <!-- Version label bottom-left on target side -->
            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Bottom"
                       Foreground="{StaticResource PrimaryFgBrush}" Opacity="0.7"
                       Text="{Binding Target.ServerVersion}"
                       IsVisible="{Binding Target.ServerVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       HorizontalAlignment="Left" Margin="0,0,0,4" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Right" Margin="0,0,10,0">
              <TextBlock Text="Destinazione" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryFgBrush}" HorizontalAlignment="Right" Opacity="0.8" />
              <TextBlock Text="{Binding Target.DisplayBandName}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryFgBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding Target.DatabaseName}" FontSize="12"
                         Foreground="{StaticResource PrimaryFgBrush}" TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Right" Opacity="0.8"
                         IsVisible="{Binding Target.DatabaseName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Path Grid.Column="2" Width="28" Height="28" Stretch="Uniform"
                  Stroke="{Binding Target.ServerMajorVersion, Converter={x:Static v:Converters.MajorVersionToBrush}}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent" VerticalAlignment="Center"
                  Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
          </Grid>
        </Border>

      </Grid>

      <!-- Two endpoint panels side by side -->
      <Grid Grid.Row="1" ColumnDefinitions="*,1,*">

        <!-- ── SOURCE panel ───────────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="0" Padding="16">
          <StackPanel Spacing="10" DataContext="{Binding Source}">

            <!-- Server label + inline counter -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Server" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
              <TextBlock FontSize="11" Foreground="{StaticResource FgSubtleBrush}"
                         Text="{Binding ServerCountText}"
                         IsVisible="{Binding HasServerSuggestions}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <AutoCompleteBox x:Name="SrcServerBox" Grid.Column="0"
                               Text="{Binding ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ItemsSource="{Binding ServerSuggestions}"
                               ValueMemberBinding="{Binding Name}"
                               FilterMode="Custom"
                               MinimumPrefixLength="0" MinimumPopulateDelay="0"
                               PlaceholderText="Scrivi o seleziona…">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate DataType="sql:DiscoveredServer">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                 FontSize="11" Margin="12,0,0,0"
                                 Foreground="{StaticResource FgSubtleBrush}"
                                 IsVisible="{Binding IpAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      Click="OnSrcServerDropToggleClick" IsVisible="{Binding HasServerSuggestions}"
                      ToolTip.Tip="Mostra elenco server rilevati">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Data="M 5,8 L 12,15 L 19,8" />
              </Button>
              <Button Grid.Column="2" Classes="ghost-violet" Margin="6,0,0,0"
                      MinWidth="120" MaxWidth="120"
                      Command="{Binding $parent[Window].((vm:ProjectSetupViewModel)DataContext).ScanForCommand}"
                      CommandParameter="source"
                      ToolTip.Tip="Cerca server SQL in rete (popola entrambi i pannelli)">
                <Panel>
                  <!-- Idle: icon + label -->
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !IsScanningServers}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                          Data="M 11,4 A 7,7 0 1 1 4,11 A 7,7 0 0 1 11,4 M 16,16 L 20,20" />
                    <TextBlock Text="Scansiona" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- Busy: slim progress bar centred in the button (≤ button width) -->
                  <ProgressBar IsIndeterminate="True" Height="6"
                               MaxWidth="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Violet500Brush}"
                               Background="{StaticResource Violet100Brush}"
                               IsVisible="{Binding IsScanningServers}" ShowProgressText="False" />
                </Panel>
              </Button>
            </Grid>
            <!-- Error-only scan status (counter is inline above) -->
            <TextBlock Text="{Binding ScanStatusMessage}" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}"
                       IsVisible="{Binding ScanStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="Autenticazione" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
            <ComboBox SelectedIndex="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.Instance}}"
                      HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Autenticazione SQL Server" />
              <ComboBoxItem Content="Autenticazione Windows" />
            </ComboBox>

            <TextBlock Text="Utente" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}"
                       IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
            <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />

            <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}"
                       IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
            <!-- Password row: box + reveal button -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}">
              <TextBox x:Name="SrcPasswordBox" Grid.Column="0"
                       Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="&#x2022;" />
              <Button x:Name="SrcRevealButton" Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      ToolTip.Tip="Tieni premuto per mostrare la password">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M 2,12 C 4,7 8,4 12,4 C 16,4 20,7 22,12 C 20,17 16,20 12,20 C 8,20 4,17 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 0 0 12,9 Z" />
              </Button>
            </Grid>

            <!-- Action row: checkboxes + Connetti button (always visible) -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <CheckBox Grid.Column="0" Content="Ricorda credenziali"
                        IsChecked="{Binding RememberCredentials, Mode=TwoWay}"
                        IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
              <CheckBox Grid.Column="1" Content="Cripta" Margin="12,0,0,0"
                        IsChecked="{Binding Encrypt, Mode=TwoWay}" />
              <CheckBox Grid.Column="2" Content="Fidati del certificato" Margin="12,0,0,0"
                        IsChecked="{Binding TrustServerCertificate, Mode=TwoWay}" />
              <Button Grid.Column="4" Classes="ghost-emerald" MinWidth="110" MaxWidth="110"
                      Command="{Binding LoadDatabasesCommand}" ToolTip.Tip="Connetti e carica database">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !IsLoadingDatabases}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                          Data="M 5,12 L 19,12 M 13,6 L 19,12 L 13,18" />
                    <TextBlock Text="Connetti" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar IsIndeterminate="True" Height="6"
                               MaxWidth="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Emerald500Brush}"
                               Background="{StaticResource Emerald100Brush}"
                               IsVisible="{Binding IsLoadingDatabases}" ShowProgressText="False" />
                </Panel>
              </Button>
            </Grid>

            <!-- Database label + inline counter -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Database" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
              <TextBlock FontSize="11" Foreground="{StaticResource FgSubtleBrush}"
                         Text="{Binding DatabaseCountText}"
                         IsVisible="{Binding HasDatabases}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox x:Name="SrcDatabaseBox" Grid.Column="0"
                               Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ItemsSource="{Binding AvailableDatabases}"
                               FilterMode="None" MinimumPrefixLength="0" MinimumPopulateDelay="0"
                               PlaceholderText="Scegli un database…" IsVisible="{Binding HasDatabases}" />
              <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      Click="OnSrcDatabaseDropToggleClick" IsVisible="{Binding HasDatabases}"
                      ToolTip.Tip="Mostra elenco database">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Data="M 5,8 L 12,15 L 19,8" />
              </Button>
            </Grid>
            <TextBox Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Nome database…" IsVisible="{Binding !HasDatabases}" />
            <!-- Error-only connection status (success is implied by the populated combo above) -->
            <TextBlock Text="{Binding ConnectionStatusMessage}" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}"
                       IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
        </ScrollViewer>

        <!-- vertical divider -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ── TARGET panel ───────────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="2" Padding="16">
          <StackPanel Spacing="10" DataContext="{Binding Target}">

            <!-- Server label + inline counter -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Server" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
              <TextBlock FontSize="11" Foreground="{StaticResource FgSubtleBrush}"
                         Text="{Binding ServerCountText}"
                         IsVisible="{Binding HasServerSuggestions}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <AutoCompleteBox x:Name="TgtServerBox" Grid.Column="0"
                               Text="{Binding ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ItemsSource="{Binding ServerSuggestions}"
                               ValueMemberBinding="{Binding Name}"
                               FilterMode="Custom"
                               MinimumPrefixLength="0" MinimumPopulateDelay="0"
                               PlaceholderText="Scrivi o seleziona…">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate DataType="sql:DiscoveredServer">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                 FontSize="11" Margin="12,0,0,0"
                                 Foreground="{StaticResource FgSubtleBrush}"
                                 IsVisible="{Binding IpAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      Click="OnTgtServerDropToggleClick" IsVisible="{Binding HasServerSuggestions}"
                      ToolTip.Tip="Mostra elenco server rilevati">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Data="M 5,8 L 12,15 L 19,8" />
              </Button>
              <Button Grid.Column="2" Classes="ghost-violet" Margin="6,0,0,0"
                      MinWidth="120" MaxWidth="120"
                      Command="{Binding $parent[Window].((vm:ProjectSetupViewModel)DataContext).ScanForCommand}"
                      CommandParameter="target"
                      ToolTip.Tip="Cerca server SQL in rete (popola entrambi i pannelli)">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !IsScanningServers}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                          Data="M 11,4 A 7,7 0 1 1 4,11 A 7,7 0 0 1 11,4 M 16,16 L 20,20" />
                    <TextBlock Text="Scansiona" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar IsIndeterminate="True" Height="6"
                               MaxWidth="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Violet500Brush}"
                               Background="{StaticResource Violet100Brush}"
                               IsVisible="{Binding IsScanningServers}" ShowProgressText="False" />
                </Panel>
              </Button>
            </Grid>
            <TextBlock Text="{Binding ScanStatusMessage}" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}"
                       IsVisible="{Binding ScanStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="Autenticazione" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
            <ComboBox SelectedIndex="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.Instance}}"
                      HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Autenticazione SQL Server" />
              <ComboBoxItem Content="Autenticazione Windows" />
            </ComboBox>

            <TextBlock Text="Utente" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}"
                       IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
            <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />

            <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}"
                       IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
            <!-- Password row: box + reveal button -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}">
              <TextBox x:Name="TgtPasswordBox" Grid.Column="0"
                       Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="&#x2022;" />
              <Button x:Name="TgtRevealButton" Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      ToolTip.Tip="Tieni premuto per mostrare la password">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                      Data="M 2,12 C 4,7 8,4 12,4 C 16,4 20,7 22,12 C 20,17 16,20 12,20 C 8,20 4,17 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 0 0 12,9 Z" />
              </Button>
            </Grid>

            <!-- Action row: checkboxes + Connetti button (always visible) -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <CheckBox Grid.Column="0" Content="Ricorda credenziali"
                        IsChecked="{Binding RememberCredentials, Mode=TwoWay}"
                        IsVisible="{Binding AuthMode, Converter={x:Static vm:AuthModeConverter.IsSqlServer}}" />
              <CheckBox Grid.Column="1" Content="Cripta" Margin="12,0,0,0"
                        IsChecked="{Binding Encrypt, Mode=TwoWay}" />
              <CheckBox Grid.Column="2" Content="Fidati del certificato" Margin="12,0,0,0"
                        IsChecked="{Binding TrustServerCertificate, Mode=TwoWay}" />
              <Button Grid.Column="4" Classes="ghost-emerald" MinWidth="110" MaxWidth="110"
                      Command="{Binding LoadDatabasesCommand}" ToolTip.Tip="Connetti e carica database">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding !IsLoadingDatabases}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
                          Data="M 5,12 L 19,12 M 13,6 L 19,12 L 13,18" />
                    <TextBlock Text="Connetti" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar IsIndeterminate="True" Height="6"
                               MaxWidth="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Emerald500Brush}"
                               Background="{StaticResource Emerald100Brush}"
                               IsVisible="{Binding IsLoadingDatabases}" ShowProgressText="False" />
                </Panel>
              </Button>
            </Grid>

            <!-- Database label + inline counter -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Database" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
              <TextBlock FontSize="11" Foreground="{StaticResource FgSubtleBrush}"
                         Text="{Binding DatabaseCountText}"
                         IsVisible="{Binding HasDatabases}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox x:Name="TgtDatabaseBox" Grid.Column="0"
                               Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ItemsSource="{Binding AvailableDatabases}"
                               FilterMode="None" MinimumPrefixLength="0" MinimumPopulateDelay="0"
                               PlaceholderText="Scegli un database…" IsVisible="{Binding HasDatabases}" />
              <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                      Click="OnTgtDatabaseDropToggleClick" IsVisible="{Binding HasDatabases}"
                      ToolTip.Tip="Mostra elenco database">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Data="M 5,8 L 12,15 L 19,8" />
              </Button>
            </Grid>
            <TextBox Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Nome database…" IsVisible="{Binding !HasDatabases}" />
            <TextBlock Text="{Binding ConnectionStatusMessage}" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}"
                       IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
        </ScrollViewer>

      </Grid>

    </Grid>

    <!-- ── Action bar ─────────────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Background="{StaticResource BgMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">

        <Button Classes="ghost" Click="OnSaveClick" ToolTip.Tip="Salva progetto">
          <TextBlock Text="Salva" />
        </Button>

        <Button Classes="ghost" Click="OnSaveAsClick" ToolTip.Tip="Salva progetto con nome">
          <TextBlock Text="Salva con nome…" />
        </Button>

        <Button Classes="ghost" Click="OnLoadClick" ToolTip.Tip="Carica un progetto esistente">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  VerticalAlignment="Center"
                  Data="M 4,7 L 4,18 L 20,18 L 20,9 L 12,9 L 10,7 Z" />
            <TextBlock Text="Carica…" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="ghost" Command="{Binding SwapEndpointsCommand}"
                ToolTip.Tip="Scambia provenienza e destinazione">
          <Path Width="16" Height="16" Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                Fill="Transparent"
                Data="M 4,9 L 20,9 M 14,4 L 20,9 L 14,14 M 20,15 L 4,15 M 10,10 L 4,15 L 10,20" />
        </Button>

        <!-- Clona configurazione: copies all source-panel fields to target -->
        <Button Classes="ghost" Command="{Binding CloneSourceToTargetCommand}"
                ToolTip.Tip="Clona la configurazione di provenienza nella destinazione">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 8,4 L 16,4 L 16,14 L 8,14 Z M 5,8 L 5,18 L 13,18" />
            <TextBlock Text="Clona" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
        </Button>

        <Button Classes="primary" IsEnabled="{Binding IsValid}" Click="OnOkClick">
          <TextBlock Text="OK" />
        </Button>

        <Button Classes="ghost" Click="OnCancelClick">
          <TextBlock Text="Annulla" />
        </Button>

      </StackPanel>
    </Border>

  </Grid>
</Window>
