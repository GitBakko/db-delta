<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:DbDelta.App.Views.Controls"
             x:Class="DbDelta.App.Views.Controls.PasswordBox"
             x:DataType="c:PasswordBox"
             x:Name="Self">

  <!-- Masked TextBox + hold-to-reveal ghost button. Bind Password to the
       view-model field via the Password styled property; everything else
       (PasswordChar masking, pointer handlers, eye icon) lives inside this
       control. See CLAUDE.md UI rule #3 (DRY). -->
  <Grid ColumnDefinitions="*,Auto">
    <!-- MaskedTextBox, not TextBox: PasswordChar hides the pixels, and the
         automation tree published the text anyway. -->
    <c:MaskedTextBox x:Name="PART_PasswordBox" Grid.Column="0"
                     Text="{Binding Password, ElementName=Self, Mode=TwoWay}"
                     PasswordChar="&#x2022;" />
    <Button x:Name="PART_RevealButton" Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
            ToolTip.Tip="{Binding RevealTooltip, ElementName=Self}">
      <Path Width="14" Height="14" Stretch="Uniform"
            Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeLineCap="Round"
            Data="M 2,12 C 4,7 8,4 12,4 C 16,4 20,7 22,12 C 20,17 16,20 12,20 C 8,20 4,17 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 0 0 12,9 Z" />
    </Button>
  </Grid>

</UserControl>
