<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:v="using:DbDelta.App.Views"
        xmlns:sql="using:DbDelta.Persistence.Sql"
        x:Class="DbDelta.App.Views.ConnectionEditDialog"
        x:DataType="vm:ConnectionEditViewModel"
        Title="Modifica connessione"
        Width="600" Height="820"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BgBrush}">

  <Grid RowDefinitions="*,Auto" Margin="16">

    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12">

        <TextBlock Text="Nome" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Server" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <AutoCompleteBox x:Name="ServerBox"
                           Grid.Column="0"
                           Text="{Binding ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding ServerSuggestions}"
                           ValueMemberBinding="{Binding Name}"
                           FilterMode="None"
                           MinimumPrefixLength="0"
                           MinimumPopulateDelay="0"
                           PlaceholderText="Scrivi o seleziona un server SQL…">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate DataType="sql:DiscoveredServer">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             FontSize="12" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding IpAddress}"
                             FontSize="11"
                             Margin="12,0,0,0"
                             Foreground="{StaticResource FgSubtleBrush}"
                             IsVisible="{Binding IpAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>
          <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                  Click="OnServerDropToggleClick"
                  IsVisible="{Binding HasServerSuggestions}"
                  ToolTip.Tip="Mostra elenco server rilevati">
            <Path Width="12" Height="12" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 5,8 L 12,15 L 19,8" />
          </Button>
          <Button Grid.Column="2" Classes="ghost-violet" Margin="6,0,0,0"
                  Command="{Binding LoadServerSuggestionsCommand}"
                  IsEnabled="{Binding !IsScanning}"
                  ToolTip.Tip="Cerca server SQL in rete">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="14" Height="14"
                           IsVisible="{Binding IsScanning}"
                           ShowProgressText="False" />
              <Path Width="14" Height="14" Stretch="Uniform"
                    IsVisible="{Binding !IsScanning}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.7" StrokeLineCap="Round"
                    Data="M 11,4 A 7,7 0 1 1 4,11 A 7,7 0 0 1 11,4 M 16,16 L 20,20" />
              <TextBlock Text="Scansiona" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding ScanStatusMessage}"
                   FontSize="11"
                   Foreground="{StaticResource FgMutedBrush}"
                   IsVisible="{Binding ScanStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="Utente" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox x:Name="PasswordBox" Grid.Column="0"
                   Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PasswordChar="&#x2022;" />
          <Button x:Name="RevealButton" Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                  ToolTip.Tip="Tieni premuto per mostrare la password">
            <Path Width="14" Height="14" Stretch="Uniform"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.7" StrokeLineCap="Round"
                  Data="M 2,12 C 4,7 8,4 12,4 C 16,4 20,7 22,12 C 20,17 16,20 12,20 C 8,20 4,17 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 0 0 12,9 Z" />
          </Button>
          <Button Grid.Column="2" Classes="ghost-emerald" Margin="6,0,0,0"
                  Command="{Binding LoadDatabasesCommand}"
                  IsEnabled="{Binding !IsLoadingDatabases}"
                  ToolTip.Tip="Verifica credenziali e carica i database disponibili">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="14" Height="14"
                           IsVisible="{Binding IsLoadingDatabases}"
                           ShowProgressText="False" />
              <Path Width="14" Height="14" Stretch="Uniform"
                    IsVisible="{Binding !IsLoadingDatabases}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.7" StrokeLineCap="Round"
                    Data="M 5,12 L 19,12 M 13,6 L 19,12 L 13,18" />
              <TextBlock Text="Connetti" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding ConnectionStatusMessage}" FontSize="11"
                   Foreground="{StaticResource FgMutedBrush}"
                   IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Database section appears only after a successful Connetti round -->
        <StackPanel Spacing="12" IsVisible="{Binding HasDatabases}">
          <TextBlock Text="Database" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
          <Grid ColumnDefinitions="*,Auto">
            <AutoCompleteBox x:Name="DatabaseBox"
                             Grid.Column="0"
                             Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ItemsSource="{Binding AvailableDatabases}"
                             FilterMode="None"
                             MinimumPrefixLength="0"
                             MinimumPopulateDelay="0"
                             PlaceholderText="Scegli un database…" />
            <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0"
                    Click="OnDatabaseDropToggleClick"
                    ToolTip.Tip="Mostra elenco database">
              <Path Width="12" Height="12" Stretch="Uniform"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Fill="Transparent"
                    Data="M 5,8 L 12,15 L 19,8" />
            </Button>
          </Grid>
        </StackPanel>

        <TextBlock Text="Tag ambiente" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <TextBox Text="{Binding EnvironmentTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Dev / Test / Prod / …" />

        <TextBlock Text="Colore ambiente" FontWeight="SemiBold" Foreground="{StaticResource FgStrongBrush}" />
        <ItemsControl ItemsSource="{Binding ColorPalette}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:EnvironmentColorOption">
              <Border Width="40" Height="40"
                      Margin="0,0,6,6"
                      CornerRadius="6"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Cursor="Hand"
                      Tag="{Binding Hex}"
                      Tapped="OnColorSwatchTapped"
                      Background="{Binding Hex, Converter={x:Static v:Converters.HexToBrush}}"
                      ToolTip.Tip="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="14" Height="14" CornerRadius="3"
                  Background="{Binding EnvironmentColorHex, Converter={x:Static v:Converters.HexToBrush}}" />
          <TextBlock Text="{Binding EnvironmentColorHex}"
                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                     Foreground="{StaticResource FgSubtleBrush}" />
        </StackPanel>

        <CheckBox Content="Aggiungi ai preferiti (pin in cima)"
                  IsChecked="{Binding IsPinned, Mode=TwoWay}" />

      </StackPanel>
    </ScrollViewer>

    <!-- Action bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Classes="ghost-crimson" Click="OnDeleteClick"
              IsVisible="{Binding !IsNew}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.7" StrokeLineCap="Round"
                Data="M 5,7 L 19,7 M 9,7 L 9,4 L 15,4 L 15,7 M 6,7 L 7,20 L 17,20 L 18,7 M 10,11 L 10,17 M 14,11 L 14,17" />
          <TextBlock Text="Elimina" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="ghost" Click="OnCancelClick">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.7" StrokeLineCap="Round"
                Data="M 6,6 L 18,18 M 6,18 L 18,6" />
          <TextBlock Text="Annulla" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="primary"
              IsEnabled="{Binding IsValid}"
              Click="OnSaveClick">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="14" Height="14" Stretch="Uniform"
                Stroke="{StaticResource PrimaryFgBrush}"
                StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                Fill="Transparent"
                Data="M 5,12 L 10,17 L 19,7" />
          <TextBlock Text="Salva" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

  </Grid>
</Window>
