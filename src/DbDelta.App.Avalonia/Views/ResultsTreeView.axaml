<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             xmlns:v="using:DbDelta.App.Views"
             xmlns:dto="using:DbDelta.Shared.Dtos"
             x:Class="DbDelta.App.Views.ResultsTreeView"
             x:DataType="vm:AppStateViewModel">

  <!-- Three mutually exclusive states: no result, empty result, populated -->
  <Panel>

    <!-- 1. No comparison yet -->
    <Border Classes="surface-subtle"
            IsVisible="{Binding LastComparison, Converter={x:Static ObjectConverters.IsNull}}"
            Padding="24"
            HorizontalAlignment="Stretch">
      <TextBlock Text="Nessun confronto eseguito. Inserisci due stringhe di connessione e premi Confronta."
                 HorizontalAlignment="Center"
                 FontStyle="Italic"
                 Foreground="{StaticResource FgSubtleBrush}" />
    </Border>

    <!-- 2. Populated — DataGrid is edge-to-edge inside the surface card;
         padding lives on the header strip only. -->
    <Border Classes="surface-raised"
            ClipToBounds="True"
            Padding="0"
            IsVisible="{Binding LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header: title + count badge -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,12,12,8">
          <TextBlock Grid.Column="0"
                     Text="Risultati"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1"
                  Classes="badge badge-outline"
                  Padding="8,3"
                  VerticalAlignment="Center">
            <TextBlock FontSize="11"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       Foreground="{StaticResource FgMutedBrush}"
                       VerticalAlignment="Center">
              <Run Text="{Binding FilteredDifferences.Count}" />
              <Run Text=" / " />
              <Run Text="{Binding LastComparison.Differences.Count}" />
              <Run Text=" oggetti" />
            </TextBlock>
          </Border>
        </Grid>

        <!-- Toolbar: filter picker -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="12,0,12,8">
          <TextBlock Grid.Column="0"
                     Text="Filtra per tipo:"
                     FontSize="12"
                     Foreground="{StaticResource FgMutedBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding StatusFilterOptions}"
                    SelectedValue="{Binding StatusFilter, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value}"
                    DisplayMemberBinding="{Binding Label}"
                    MinWidth="200" />
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredDifferences}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
          <DataGrid.Columns>

            <!-- Status strip (4px colored bar driven by Status) -->
            <DataGridTemplateColumn Width="6" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="dto:DifferenceDto">
                  <Border Width="4"
                          HorizontalAlignment="Left"
                          Background="{Binding Status, Converter={x:Static v:Converters.StatusToStripBrush}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Oggetto"
                                Binding="{Binding Kind}"
                                Width="110"
                                FontFamily="Cascadia Mono,Consolas,monospace" />
            <DataGridTextColumn Header="Schema"
                                Binding="{Binding SchemaName}"
                                Width="100" />
            <DataGridTextColumn Header="Nome"
                                Binding="{Binding ObjectName}"
                                Width="*"
                                FontWeight="Medium" />
            <DataGridTemplateColumn Header="Tipo" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="dto:DifferenceDto">
                  <Border Classes="badge"
                          Classes.modified="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=Different}"
                          Classes.only-source="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=OnlyInA}"
                          Classes.only-target="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=OnlyInB}"
                          Classes.identical="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=Identical}"
                          Padding="10,4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Converter={x:Static v:Converters.StatusToDisplayName}}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

  </Panel>

</UserControl>
