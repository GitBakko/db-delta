<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             xmlns:v="using:DbDelta.App.Views"
             xmlns:dto="using:DbDelta.Shared.Dtos"
             x:Class="DbDelta.App.Views.ResultsTreeView"
             x:DataType="vm:AppStateViewModel">

  <!-- Three mutually exclusive states: no result, empty result, populated -->
  <Panel>

    <!-- 1. No comparison yet -->
    <Border Classes="surface-subtle"
            IsVisible="{Binding LastComparison, Converter={x:Static ObjectConverters.IsNull}}"
            Padding="24"
            HorizontalAlignment="Stretch">
      <TextBlock Text="No comparison run yet. Enter two connection strings and click Compare."
                 HorizontalAlignment="Center"
                 FontStyle="Italic"
                 Foreground="{StaticResource FgSubtleBrush}" />
    </Border>

    <!-- 2. Populated -->
    <Border Classes="surface-raised"
            Padding="12"
            IsVisible="{Binding LastComparison, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0"
                     Text="Results"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}" />
          <Border Grid.Column="1"
                  Classes="badge badge-outline"
                  Padding="8,3">
            <TextBlock FontSize="11"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       Foreground="{StaticResource FgMutedBrush}">
              <Run Text="{Binding LastComparison.Differences.Count}" />
              <Run Text=" objects" />
            </TextBlock>
          </Border>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding LastComparison.Differences}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
          <DataGrid.Columns>

            <!-- Status strip (4px colored bar driven by Status) -->
            <DataGridTemplateColumn Width="6" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="dto:DifferenceDto">
                  <Border Width="4"
                          HorizontalAlignment="Left"
                          Background="{Binding Status, Converter={x:Static v:Converters.StatusToStripBrush}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Kind"
                                Binding="{Binding Kind}"
                                Width="110"
                                FontFamily="Cascadia Mono,Consolas,monospace" />
            <DataGridTextColumn Header="Schema"
                                Binding="{Binding SchemaName}"
                                Width="100" />
            <DataGridTextColumn Header="Name"
                                Binding="{Binding ObjectName}"
                                Width="*"
                                FontWeight="Medium" />
            <DataGridTemplateColumn Header="Status" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="dto:DifferenceDto">
                  <Border Classes="badge"
                          Classes.modified="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=Different}"
                          Classes.only-source="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=OnlyInA}"
                          Classes.only-target="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=OnlyInB}"
                          Classes.identical="{Binding Status, Converter={x:Static v:Converters.IsStatus}, ConverterParameter=Identical}"
                          Padding="8,2"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Status}" FontSize="11" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

  </Panel>

</UserControl>
