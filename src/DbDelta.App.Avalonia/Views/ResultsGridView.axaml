<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             xmlns:v="using:DbDelta.App.Views"
             xmlns:ag="using:Avalonia.Collections"
             x:Class="DbDelta.App.Views.ResultsGridView"
             x:DataType="vm:MainWindowViewModel">

  <Panel>

    <!-- No comparison yet -->
    <Border Classes="surface-subtle"
            IsVisible="{Binding AppState.LastComparison,
                                Converter={x:Static ObjectConverters.IsNull}}"
            Padding="24"
            HorizontalAlignment="Stretch">
      <TextBlock Text="Nessun confronto eseguito. Inserisci due stringhe di connessione e premi Confronta."
                 HorizontalAlignment="Center"
                 FontStyle="Italic"
                 Foreground="{StaticResource FgSubtleBrush}" />
    </Border>

    <!-- Results DataGrid -->
    <Border Classes="surface-raised"
            ClipToBounds="True"
            Padding="0"
            IsVisible="{Binding AppState.LastComparison,
                                Converter={x:Static ObjectConverters.IsNotNull}}">

      <!-- ColumnHeaderHeight is pinned rather than auto-sized: left to the text
           it comes out under 20 px and vertically clips the select-all box in
           the checkbox column. 32 is the app's monoline height and what the
           group headers already use. -->
      <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding RowsView}"
                SelectedItem="{Binding AppState.SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ColumnHeaderHeight="32"
                LoadingRowGroup="OnLoadingRowGroup">

        <DataGrid.Styles>
          <!-- Row hover/selected tints follow the row's status colour: blue
               for Modified, red for Solo destinazione, green for Solo
               provenienza, grey for Identici. Theme-aware (round-15) — the
               converters resolve to soft tints in light mode and deep
               accent shades in dark mode so text contrast is preserved
               across themes. -->
          <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{Binding ((vm:DifferenceRowViewModel)DataContext).Status, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={x:Static v:Converters.StatusToRowHoverBrush}}" />
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{Binding ((vm:DifferenceRowViewModel)DataContext).Status, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={x:Static v:Converters.StatusToRowSelectedBrush}}" />
            <Setter Property="Opacity" Value="1" />
          </Style>

          <!-- Group header: 6-px coloured stripe + italian label + item count.
               The stripe colour is derived from the grouping key (the italian
               status label) via StatusKeyToBrush converter. -->
          <Style Selector="DataGridRowGroupHeader">
            <Setter Property="Background" Value="{StaticResource BgMutedBrush}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
              <ControlTemplate x:DataType="ag:DataGridCollectionViewGroup">
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{TemplateBinding Background}">
                  <!-- Columns 2..7 MIRROR the DataGrid's own so the group's
                       select-all box lands in the same column as the per-row
                       boxes it drives. Column 0 replaces the indent the grid
                       gives a grouped DATA row (DataGridRowGroupHeader's
                       SublevelIndent, 10 px per level) — this template draws the
                       whole header, so without it every cell above sits 10 px
                       left of the cells below. Keep the widths in step with
                       DataGrid.Columns: nothing enforces it, and a user-resized
                       column drifts them apart until the grid is rebuilt. -->
                  <Grid ColumnDefinitions="10,100,140,*,40,*,140">

                    <!-- Stripe + expander + label + count share the three
                         columns to the left of the checkbox column. -->
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="6,Auto,Auto,*">
                      <!-- 6-px status colour stripe -->
                      <Border Grid.Column="0"
                              Background="{Binding Key, Converter={x:Static v:Converters.StatusKeyToBrush}}" />
                    <!-- PART_ExpanderButton — DataGrid wires this ToggleButton's
                         IsChecked to the group's expansion state. Single click
                         toggles. The chevron Path rotates -90° when checked
                         (i.e. expanded) so it visually maps to ▶ collapsed /
                         ▼ expanded. -->
                    <ToggleButton Grid.Column="1"
                                  x:Name="PART_ExpanderButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="6,0"
                                  MinHeight="0"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Cursor="Hand">
                      <ToggleButton.Styles>
                        <!-- Strip the FluentTheme ToggleButton background so
                             it stays a flat clickable cell. -->
                        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
                          <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                      </ToggleButton.Styles>
                      <Path Width="10" Height="10" Stretch="Uniform"
                            Stroke="{StaticResource FgMutedBrush}"
                            StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                            Fill="Transparent"
                            RenderTransformOrigin="50%,50%"
                            Data="M 8,5 L 15,12 L 8,19">
                        <Path.Styles>
                          <!-- Default (unchecked → collapsed) = pointing right ▶.
                               When ToggleButton is checked (expanded) rotate
                               +90° → chevron points down ▼. -->
                          <Style Selector="ToggleButton:checked Path">
                            <Setter Property="RenderTransform" Value="rotate(90deg)" />
                          </Style>
                        </Path.Styles>
                      </Path>
                    </ToggleButton>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Key}"
                                 Margin="8,0,0,0"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource FgStrongBrush}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding ItemCount, StringFormat='({0})'}"
                                 Margin="6,0,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource FgSubtleBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <!-- Select / deselect every row of this group, in the same
                         column as the row boxes. IsChecked is OneWay: the click
                         is carried by the Command and the binding re-asserts the
                         real state straight after, so the box can never disagree
                         with the rows underneath. The SelectedCount leg is what
                         makes it re-evaluate at all — see
                         GroupSelectionStateConverter. -->
                    <CheckBox Grid.Column="4"
                              MinWidth="0"
                              Padding="0"
                              IsThreeState="True"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding Converter={x:Static v:Converters.GroupHasSelectableRows}}"
                              ToolTip.Tip="Seleziona o deseleziona tutte le righe di questo gruppo"
                              Command="{Binding ((vm:MainWindowViewModel)DataContext).ToggleGroupCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}">
                      <CheckBox.IsChecked>
                        <MultiBinding Converter="{x:Static v:Converters.GroupSelectionState}"
                                      Mode="OneWay">
                          <Binding />
                          <Binding Path="((vm:MainWindowViewModel)DataContext).SelectedCount"
                                   RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                        </MultiBinding>
                      </CheckBox.IsChecked>
                    </CheckBox>
                  </Grid>
                </Border>
              </ControlTemplate>
            </Setter>
          </Style>
        </DataGrid.Styles>

        <DataGrid.Columns>

          <!-- Col 1: Status pill + Kind label -->
          <DataGridTemplateColumn Header="Tipo entità" Width="100" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                  <!-- Coloured status square -->
                  <Border Width="6" Height="6"
                          CornerRadius="1"
                          Background="{Binding SelectionBrushHex,
                                               Converter={x:Static v:Converters.HexToBrush}}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="{Binding KindDisplayName}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Col 2: Last modified source -->
          <DataGridTemplateColumn Header="Ultima modifica (orig)" Width="140" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <TextBlock Text="{Binding LastModifiedSourceDisplay}"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="4,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Col 3: Source object name. Hidden when the row exists only on
               the target — leaves the cell empty to make the missing side
               visually obvious. -->
          <DataGridTemplateColumn Header="Nome (orig)" Width="*" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <TextBlock Text="{Binding QualifiedName}"
                           IsVisible="{Binding HasSourceName}"
                           FontWeight="{Binding IsSourceOnly,
                                                Converter={x:Static v:Converters.BoolToFontWeight}}"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Col 4: Deploy selection checkbox — the ONLY column with vertical
               borders so it visually demarcates the boundary between source
               and target name columns. -->
          <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
            <!-- Select / deselect every VISIBLE difference, sitting directly
                 above the per-row boxes it drives. Acts on what the search box
                 leaves on screen and never on hidden rows: a row silently added
                 to the selection becomes a statement in the deploy script that
                 nobody reviewed. -->
            <!-- Through a TEMPLATE, not a live CheckBox in Header: a control
                 instance has one visual parent, so the moment the grid rebuilds
                 its header row the box detaches and is simply never seen again.
                 A template mints a fresh one for every realisation. -->
            <DataGridTemplateColumn.Header>
              <x:String>selectAll</x:String>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <!-- Explicit size, not MinWidth=0: the Fluent CheckBox draws its
                     box from the template's own measure, so zeroing the minimum
                     let it collapse to nothing inside a column header — present
                     in the tree, zero pixels wide, invisible on screen. -->
                <CheckBox IsThreeState="True"
                          Width="20"
                          Height="20"
                          MinWidth="20"
                          MinHeight="20"
                          Padding="0"
                          Margin="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Seleziona o deseleziona tutte le differenze visibili"
                          IsChecked="{Binding ((vm:MainWindowViewModel)DataContext).AllVisibleSelected,
                                              RelativeSource={RelativeSource AncestorType=DataGrid},
                                              Mode=OneWay}"
                          Command="{Binding ((vm:MainWindowViewModel)DataContext).ToggleAllVisibleCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,1,0"
                        Padding="0">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsVisible="{Binding IsSelectable}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding SelectionBrushHex,
                                                 Converter={x:Static v:Converters.HexToBrush}}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Col 5: Target object name. Hidden when the row exists only on
               the source — leaves the cell empty to surface the missing side. -->
          <DataGridTemplateColumn Header="Nome (dest)" Width="*" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <TextBlock Text="{Binding QualifiedName}"
                           IsVisible="{Binding HasTargetName}"
                           FontWeight="{Binding IsTargetOnly,
                                                Converter={x:Static v:Converters.BoolToFontWeight}}"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Col 6: Last modified target -->
          <DataGridTemplateColumn Header="Ultima modifica (dest)" Width="140" CanUserSort="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:DifferenceRowViewModel">
                <TextBlock Text="{Binding LastModifiedTargetDisplay}"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="4,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>

    </Border>

  </Panel>

</UserControl>
