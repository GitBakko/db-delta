<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbDelta.App.ViewModels"
        xmlns:c="using:DbDelta.App.Views.Controls"
        x:Class="DbDelta.App.Views.ConfirmExecuteDialog"
        x:DataType="vm:ConfirmExecuteViewModel"
        Title="Esecuzione allineamento"
        Icon="/Assets/app-icon.png"
        Width="880" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BgBrush}">

  <StackPanel Margin="24" Spacing="14">

    <!-- Alert header band -->
    <!-- DangerStrong, not Danger: the dark ramp lightens Danger so it reads as
         an accent on a near-black page, and white text on THAT measures 3.1:1.
         Text and icon take FgOnAccent rather than a hardcoded White, so the
         design system decides what "on an accent" means. -->
    <Border x:Name="DangerBand"
            Background="{StaticResource DangerStrongBrush}" CornerRadius="6" Padding="14,10">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
              Fill="{StaticResource FgOnAccentBrush}"
              Data="M 12,2 L 22,20 L 2,20 Z M 12,9 L 12,14 M 12,16 L 12,18" />
        <StackPanel Spacing="2">
          <TextBlock Text="Esecuzione diretta sul database di destinazione"
                     FontWeight="SemiBold" FontSize="14"
                     Foreground="{StaticResource FgOnAccentBrush}" />
          <TextBlock Text="Lo script di allineamento verrà eseguito immediatamente sulla destinazione."
                     FontSize="12"
                     Foreground="{StaticResource FgOnAccentBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Provenienza → Destinazione flow card -->
    <Border Classes="surface-subtle" Padding="14,12">
      <Grid ColumnDefinitions="92,12,*" RowDefinitions="Auto,8,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provenienza"
                   FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource FgSubtleBrush}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SourceSummary}"
                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource FgStrongBrush}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Destinazione"
                   FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource DangerBrush}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TargetSummary}"
                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource FgStrongBrush}" />
      </Grid>
    </Border>

    <!-- Selection breakdown -->
    <Border Classes="surface-subtle" Padding="14,12">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Oggetti selezionati:"
                     Foreground="{StaticResource FgSubtleBrush}" />
          <TextBlock Text="{Binding ObjectCount}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource FgStrongBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource DiffModifiedBrush}" />
            <TextBlock FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource FgSubtleBrush}">
              <Run Text="{Binding DifferentCount}" /><Run Text=" diversi" />
            </TextBlock>
          </StackPanel>
          <!-- Not "solo destinazione": that is where these objects are, not what
               happens to them. This count is the DROP count. -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource DiffOnlyTargetBrush}" />
            <TextBlock FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{StaticResource DangerBrush}">
              <Run Text="{Binding OnlyInTargetCount}" /><Run Text=" da ELIMINARE" />
            </TextBlock>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource DiffOnlySourceBrush}" />
            <TextBlock FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource FgSubtleBrush}">
              <Run Text="{Binding OnlyInSourceCount}" /><Run Text=" solo provenienza" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- What gets deleted, by name. A count alone reads as inventory; with undo
         deferred this dialog is the last gate before the DROP runs. -->
    <Border CornerRadius="6" Padding="14,12"
            Background="{StaticResource DangerSoftBrush}"
            IsVisible="{Binding HasDrops}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding DropWarning}"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{StaticResource DangerBrush}" />
        <ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding DroppedObjectsText}"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                               Foreground="{StaticResource FgStrongBrush}" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- The script itself, collapsed. It is already built and in hand — reading
         it used to cost a cancel, a second pass through "Genera script", a second
         answer to the backfill preflight, a file save and an external editor. -->
    <!-- Padding="0" on the Expander, and 8 rather than 12 inside the border.
         The script used to sit in a box, in a box, each with its own padding,
         on a 620-wide window that could not be resized — so a line of DDL was
         clipped on BOTH sides and the reader could not do anything about it.
         The surviving inset is the one that keeps the monospace text off the
         border; everything else was space the script needed. -->
    <Expander Header="{Binding ScriptToggleLabel}" IsExpanded="False" Padding="0"
              Expanded="OnScriptExpanded">
      <Grid RowDefinitions="Auto,8,Auto">
        <Border Grid.Row="0" Classes="surface-raised" ClipToBounds="True" Padding="0">
          <ScrollViewer x:Name="ScriptPane" MaxHeight="420" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Script}" Margin="8"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                                 Foreground="{StaticResource FgStrongBrush}" />
          </ScrollViewer>
        </Border>
        <Button Grid.Row="2" Classes="ghost" HorizontalAlignment="Right"
                Click="OnCopyScriptClick">
          <TextBlock Text="Copia script" />
        </Button>
      </Grid>
    </Expander>

    <!-- Transaction note -->
    <TextBlock Text="L'esecuzione avviene in una transazione: in caso di errore viene eseguito il rollback completo e la destinazione resta invariata."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource FgSubtleBrush}" />

    <!-- Outcome: success -->
    <Border CornerRadius="6" Padding="14,12"
            Background="{StaticResource SuccessSoftBrush}"
            IsVisible="{Binding IsDoneSuccess}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
              Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.2"
              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
              Data="M 4,12 L 10,18 L 20,6" />
        <TextBlock Text="{Binding ResultMessage}"
                   TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{StaticResource SuccessBrush}" />
      </StackPanel>
    </Border>

    <!-- Outcome: failure -->
    <Border CornerRadius="6" Padding="14,12"
            Background="{StaticResource DangerSoftBrush}"
            IsVisible="{Binding IsDoneFailure}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
              Stroke="{StaticResource DangerBrush}" StrokeThickness="2.2"
              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
              Data="M 6,6 L 18,18 M 18,6 L 6,18" />
        <TextBlock Text="{Binding ResultMessage}"
                   TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{StaticResource DangerBrush}" />
      </StackPanel>
    </Border>

    <!-- Action bar -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <!-- Annulla and Chiudi are the same answer in the two phases of this
           dialog and are mutually exclusive by IsVisible, so both carry
           IsCancel: Escape has to work before the run and after it. -->
      <Button Classes="ghost" IsCancel="True" Click="OnAnnullaClick"
              IsVisible="{Binding IsIdle}">
        <TextBlock Text="Annulla" />
      </Button>
      <Button Classes="ghost" IsCancel="True" Click="OnChiudiClick"
              IsVisible="{Binding IsDone}">
        <TextBlock Text="Chiudi" />
      </Button>
      <Button Classes="solid-crimson"
              Command="{Binding ExecuteCommand}"
              IsVisible="{Binding !IsDone}">
        <c:LoadingContent IconPath="M 6,4 L 19,12 L 6,20 Z"
                          IdleText="Esegui"
                          BusyText="Esecuzione in corso…"
                          IsBusy="{Binding IsRunning}" />
      </Button>
    </StackPanel>

  </StackPanel>

</Window>
