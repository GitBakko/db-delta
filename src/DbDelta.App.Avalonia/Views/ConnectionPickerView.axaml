<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             x:Class="DbDelta.App.Views.ConnectionPickerView"
             x:DataType="vm:AppStateViewModel">

  <StackPanel Spacing="12">
    <TextBlock Text="Connections"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="{StaticResource FgStrongBrush}" />

    <!-- Source + Target endpoint cards (violet vs cobalt tint) -->
    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*">
      <Border Grid.Column="0"
              Classes="endpoint endpoint-source"
              Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="SOURCE"
                     FontSize="10"
                     FontWeight="Bold"
                     LetterSpacing="0.6"
                     Foreground="{StaticResource SecondaryBrush}" />
          <TextBox Text="{Binding SourceConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Server=.;Database=Dev;Trusted_Connection=True;TrustServerCertificate=True"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Classes="connection-input" />
        </StackPanel>
      </Border>

      <Button Grid.Column="1"
              Classes="swap"
              Margin="10,0"
              VerticalAlignment="Center"
              Command="{Binding SwapCommand}"
              ToolTip.Tip="Swap source and target">
        <Path Width="14" Height="14"
              Stretch="Uniform"
              Stroke="{Binding $parent[Button].Foreground}"
              StrokeThickness="1.8"
              StrokeLineCap="Round"
              Data="M 16,4 L 20,8 L 16,12 M 20,8 L 8,8 M 8,20 L 4,16 L 8,12 M 4,16 L 16,16" />
      </Button>

      <Border Grid.Column="2"
              Classes="endpoint endpoint-target"
              Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="TARGET"
                     FontSize="10"
                     FontWeight="Bold"
                     LetterSpacing="0.6"
                     Foreground="{StaticResource PrimaryBrush}" />
          <TextBox Text="{Binding TargetConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Server=.;Database=Prod;Trusted_Connection=True;TrustServerCertificate=True"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Classes="connection-input" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Primary action -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Classes="primary lg"
              Command="{Binding CompareCommand}"
              IsEnabled="{Binding !IsBusy}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ProgressBar IsIndeterminate="True"
                       Width="14" Height="14"
                       IsVisible="{Binding IsBusy}"
                       ShowProgressText="False" />
          <TextBlock Text="Comparing…" IsVisible="{Binding IsBusy}" />
          <Path Width="12" Height="12"
                IsVisible="{Binding !IsBusy}"
                Stretch="Uniform"
                Stroke="{Binding $parent[Button].Foreground}"
                StrokeThickness="1.8"
                StrokeLineCap="Round"
                Data="M 5,12 L 19,12 M 13,6 L 19,12 L 13,18" />
          <TextBlock Text="Compare" IsVisible="{Binding !IsBusy}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Error banner -->
    <Border Classes="alert alert-danger"
            IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Padding="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Width="16" Height="16"
              Stretch="Uniform"
              Stroke="{StaticResource DangerBrush}"
              StrokeThickness="1.8"
              Data="M 12,3 A 9,9 0 1 1 11.99,3 M 12,7 L 12,13 M 12,16 L 12.01,16" />
        <StackPanel>
          <TextBlock Text="Comparison failed."
                     FontWeight="SemiBold"
                     Foreground="{StaticResource DangerFgBrush}" />
          <TextBlock Text="{Binding LastError}"
                     FontSize="12"
                     Foreground="{StaticResource FgMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
