<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbDelta.App.Views.SaveProjectDialog"
        Title="Salva progetto"
        Width="460" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BgBrush}">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="Nome del progetto"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource FgStrongBrush}" />
      <TextBox x:Name="NameBox"
               Text=""
               PlaceholderText="es. Allineamento PcrmV2Pl"
               FontSize="13" />
      <TextBlock x:Name="HintText"
                 Text=""
                 FontSize="11"
                 Foreground="{StaticResource FgSubtleBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Classes="ghost" Click="OnCancelClick">
        <TextBlock Text="Annulla" />
      </Button>
      <Button x:Name="OkButton" Classes="primary" Click="OnOkClick">
        <TextBlock Text="Salva" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
