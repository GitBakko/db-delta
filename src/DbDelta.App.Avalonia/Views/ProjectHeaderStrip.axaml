<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             xmlns:v="using:DbDelta.App.Views"
             x:Class="DbDelta.App.Views.ProjectHeaderStrip"
             x:DataType="vm:MainWindowViewModel"
             Height="56">

  <!-- Three-column layout: Source info | Deploy actions | Target info -->
  <Grid ColumnDefinitions="*,Auto,*">

    <!-- Source DB panel — muted background with env colour left stripe -->
    <Border Grid.Column="0"
            Background="{StaticResource BgMutedBrush}"
            ClipToBounds="True">
      <Grid ColumnDefinitions="4,*">
        <!-- Env colour stripe -->
        <Border Grid.Column="0"
                Background="{Binding AppState.SourceSlot.SelectedEntry.EnvironmentColorHex,
                                     Converter={x:Static v:Converters.HexToBrush},
                                     FallbackValue={StaticResource PrimaryBrush}}" />
        <!-- Server + DB name -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Margin="12,0">
          <!-- DB cylinder icon -->
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{StaticResource FgMutedBrush}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Fill="Transparent"
                Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppState.SourceSlot.SelectedEntry.ServerName,
                                      FallbackValue='—'}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FgStrongBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="280" />
            <TextBlock Text="{Binding AppState.SourceSlot.SelectedEntry.DatabaseName,
                                      FallbackValue='Nessuna origine selezionata'}"
                       FontSize="11"
                       Foreground="{StaticResource FgSubtleBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="280" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Deploy / Execute actions (centre column) -->
    <StackPanel Grid.Column="1"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="16,0">

      <!-- Deploy button -->
      <Button Classes="primary"
              Command="{Binding DeployCommand}"
              CommandParameter="{Binding $parent[Window]}"
              ToolTip.Tip="Genera script di allineamento per le righe selezionate"
              Padding="12,5">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- play/deploy icon -->
          <Path Width="12" Height="12"
                Stretch="Uniform"
                Fill="{StaticResource PrimaryFgBrush}"
                Data="M 5,4 L 19,12 L 5,20 Z" />
          <TextBlock Text="Deploy"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryFgBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Execute on target — disabled stub for M9 -->
      <Button Classes="ghost-crimson"
              Command="{Binding ExecuteOnTargetCommand}"
              IsEnabled="False"
              ToolTip.Tip="Disponibile in M9"
              Padding="12,4">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Width="12" Height="12"
                Stretch="Uniform"
                Stroke="{StaticResource DangerBrush}"
                StrokeThickness="1.5"
                Fill="Transparent"
                Data="M 5,4 L 19,12 L 5,20 Z M 19,8 L 22,6 M 19,12 L 22,12 M 19,16 L 22,18" />
          <TextBlock Text="Esegui sul target"
                     FontSize="12"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

    </StackPanel>

    <!-- Target DB panel — primary tint background with env colour right stripe -->
    <Border Grid.Column="2"
            Background="{StaticResource PrimarySoftBrush}"
            ClipToBounds="True">
      <Grid ColumnDefinitions="*,4">
        <!-- Server + DB name (right-aligned) -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="12,0">
          <StackPanel Spacing="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <TextBlock Text="{Binding AppState.TargetSlot.SelectedEntry.ServerName,
                                      FallbackValue='—'}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimarySoftFgBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="280"
                       TextAlignment="Right" />
            <TextBlock Text="{Binding AppState.TargetSlot.SelectedEntry.DatabaseName,
                                      FallbackValue='Nessuna destinazione selezionata'}"
                       FontSize="11"
                       Foreground="{StaticResource PrimarySoftFgBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="280"
                       TextAlignment="Right" />
          </StackPanel>
          <!-- DB cylinder icon -->
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{StaticResource PrimarySoftFgBrush}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Fill="Transparent"
                Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
        </StackPanel>
        <!-- Env colour right stripe -->
        <Border Grid.Column="1"
                Background="{Binding AppState.TargetSlot.SelectedEntry.EnvironmentColorHex,
                                     Converter={x:Static v:Converters.HexToBrush},
                                     FallbackValue={StaticResource PrimaryBrush}}" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
