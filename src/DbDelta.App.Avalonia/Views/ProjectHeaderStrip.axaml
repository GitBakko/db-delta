<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbDelta.App.ViewModels"
             xmlns:v="using:DbDelta.App.Views"
             x:Class="DbDelta.App.Views.ProjectHeaderStrip"
             x:DataType="vm:MainWindowViewModel"
             Height="56">

  <!-- Two-column layout: Source info | Target info.
       Deploy / Execute actions live in the dedicated results action bar
       — see MainWindow.axaml. -->
  <Grid ColumnDefinitions="*,*">

    <!-- Source DB panel — muted background with secondary stripe on the left -->
    <Border Grid.Column="0"
            Background="{StaticResource BgMutedBrush}"
            ClipToBounds="True">
      <Grid ColumnDefinitions="4,*">
        <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Margin="12,0">
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{StaticResource FgMutedBrush}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Fill="Transparent"
                Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="PROVENIENZA"
                       FontSize="10" FontWeight="Bold" LetterSpacing="0.6"
                       Foreground="{StaticResource SecondaryBrush}" />
            <TextBlock Text="{Binding AppState.CurrentProject.Source.Connection.ServerName, FallbackValue='—'}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FgStrongBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="380" />
            <TextBlock Text="{Binding AppState.CurrentProject.Source.Connection.DatabaseName, FallbackValue='Nessuna provenienza selezionata'}"
                       FontSize="11"
                       Foreground="{StaticResource FgSubtleBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="380" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Target DB panel — primary tint background with primary stripe on the right -->
    <Border Grid.Column="1"
            Background="{StaticResource PrimarySoftBrush}"
            ClipToBounds="True">
      <Grid ColumnDefinitions="*,4">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="12,0">
          <StackPanel Spacing="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <TextBlock Text="DESTINAZIONE"
                       FontSize="10" FontWeight="Bold" LetterSpacing="0.6"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Right" />
            <TextBlock Text="{Binding AppState.CurrentProject.Target.Connection.ServerName, FallbackValue='—'}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimarySoftFgBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="380"
                       TextAlignment="Right" />
            <TextBlock Text="{Binding AppState.CurrentProject.Target.Connection.DatabaseName, FallbackValue='Nessuna destinazione selezionata'}"
                       FontSize="11"
                       Foreground="{StaticResource PrimarySoftFgBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="380"
                       TextAlignment="Right" />
          </StackPanel>
          <Path Width="16" Height="16"
                Stretch="Uniform"
                Stroke="{StaticResource PrimarySoftFgBrush}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Fill="Transparent"
                Data="M 4,6 C 4,4 8,3 12,3 C 16,3 20,4 20,6 L 20,18 C 20,20 16,21 12,21 C 8,21 4,20 4,18 Z M 4,6 C 4,8 8,9 12,9 C 16,9 20,8 20,6 M 4,12 C 4,14 8,15 12,15 C 16,15 20,14 20,12" />
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
