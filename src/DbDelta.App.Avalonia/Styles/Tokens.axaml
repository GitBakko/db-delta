    <!-- ===== Spacing (4px base grid, values in device-independent pixels) ===== -->
    <x:Double x:Key="Space0">0</x:Double>
    <x:Double x:Key="Space1">2</x:Double>
    <x:Double x:Key="Space2">4</x:Double>
    <x:Double x:Key="Space3">6</x:Double>
    <x:Double x:Key="Space4">8</x:Double>
    <x:Double x:Key="Space5">10</x:Double>
    <x:Double x:Key="Space6">12</x:Double>
    <x:Double x:Key="Space7">14</x:Double>
    <x:Double x:Key="Space8">16</x:Double>
    <x:Double x:Key="Space10">20</x:Double>
    <x:Double x:Key="Space12">24</x:Double>
    <x:Double x:Key="Space14">28</x:Double>
    <x:Double x:Key="Space16">32</x:Double>
    <x:Double x:Key="Space20">40</x:Double>
