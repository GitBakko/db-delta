    <!-- Semantic theme-aware tokens live in Themes.axaml so the same brush
         (e.g. BgBrush) flips its Color when RequestedThemeVariant changes. -->

    <!-- ===== Diff status tokens (theme-invariant) ===== -->
    <Color x:Key="DiffIdentical">#98958E</Color>
    <SolidColorBrush x:Key="DiffIdenticalBrush" Color="{StaticResource DiffIdentical}" />
    <Color x:Key="DiffModified">#1B6CDB</Color>
    <SolidColorBrush x:Key="DiffModifiedBrush" Color="{StaticResource DiffModified}" />
    <Color x:Key="DiffOnlySource">#7C60DB</Color>
    <SolidColorBrush x:Key="DiffOnlySourceBrush" Color="{StaticResource DiffOnlySource}" />
