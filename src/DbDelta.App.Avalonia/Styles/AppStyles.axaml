<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Domain control styles for DbDelta — mirror the design system. -->

  <!-- ===== Invariable rule: uniform 32-px monoline height =====
       Single-line interactive controls (Button / TextBox / ComboBox /
       AutoCompleteBox / CheckBox) all share the same MinHeight so rows of
       mixed controls read as a clean horizontal strip. See CLAUDE.md
       "UI/UX Invariable Rules" for context. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="AutoCompleteBox">
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- ===== Border surfaces ===== -->

  <Style Selector="Border.endpoint">
    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.endpoint.endpoint-source">
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>
  <Style Selector="Border.endpoint.endpoint-target">
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
  </Style>

  <Style Selector="Border.surface-raised">
    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Border.surface-subtle">
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ===== Buttons =====

       FluentTheme's default button template overrides Background AND Foreground
       on :pointerover / :pressed / :disabled via theme resources. To stay
       compliant with the DbDelta design system we override BOTH on every
       interactive state, otherwise the text becomes dark-on-dark on hover. -->

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryFgBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryActiveBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryActiveBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryFgBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryFgBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.lg">
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- "Ghost" no longer means transparent — per CLAUDE.md UI rule #1,
       every button must have a visible fill or border. The ghost class is
       now a NEUTRAL filled button (raised bg + subtle border) used for
       utility actions (Salva, Carica, Annulla, Modifica, navigation icons).
       Class name preserved to avoid touching every consumer XAML. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgStrongBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgStrongBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgStrongBrush}" />
  </Style>

  <Style Selector="Button.swap">
    <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.swap:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgStrongBrush}" />
  </Style>
  <Style Selector="Button.swap:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgMutedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgStrongBrush}" />
  </Style>

  <!-- Coloured semantic variants — per CLAUDE.md UI rule #1, every variant
       carries a SOLID accent fill at rest (no naked-transparent buttons).
       Class names ghost-* preserved for backwards-compat with existing
       consumer XAML; the styling is now "soft filled accent". -->

  <Style Selector="Button.ghost-violet">
    <Setter Property="Background" Value="{StaticResource SecondarySoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SecondarySoftFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Switch Button.Foreground (not just template TextElement) so Path icons
       bound to $parent[Button].Foreground flip to white on the saturated
       accent bg. CLAUDE.md UI rule: icon contrast must follow bg. -->
  <Style Selector="Button.ghost-violet:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-violet:pressed">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-violet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost-violet:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost-emerald">
    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost-emerald:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-emerald:pressed">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-emerald:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
  </Style>
  <Style Selector="Button.ghost-emerald:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost-amber">
    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WarningFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost-amber:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-amber:pressed">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-amber:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Button.ghost-amber:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost-crimson">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DangerFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost-crimson:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-crimson:pressed">
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-crimson:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Button.ghost-crimson:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost-cobalt">
    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimarySoftFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost-cobalt:pointerover">
    <Setter Property="Foreground" Value="{StaticResource PrimaryFgBrush}" />
  </Style>
  <Style Selector="Button.ghost-cobalt:pressed">
    <Setter Property="Foreground" Value="{StaticResource PrimaryFgBrush}" />
  </Style>
  <Style Selector="Button.ghost-cobalt:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryFgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
  </Style>
  <Style Selector="Button.ghost-cobalt:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryFgBrush}" />
  </Style>

  <!-- Solid filled variants — for "primary action" semantics other than cobalt -->

  <Style Selector="Button.solid-emerald">
    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.solid-emerald:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SuccessFgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.solid-emerald:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SuccessFgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <Style Selector="Button.solid-crimson">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.solid-crimson:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerFgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>
  <Style Selector="Button.solid-crimson:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerFgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnAccentBrush}" />
  </Style>

  <!-- ===== Busy spinner =====
       Compact in-button loading indicator. Implemented as a slim, fixed-
       width ProgressBar (Avalonia's IsIndeterminate animation is built-in
       and survives across themes). Paired with an "In corso…" TextBlock
       inside Scansiona / Connetti to replace the previous chunky inline
       progress strip. We avoid an animated RotateTransform because
       Avalonia has no built-in animator for the RenderTransform property
       (verified by the round-12 startup crash). -->
  <Style Selector="ProgressBar.spinner">
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="ShowProgressText" Value="False" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="42" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Topbar vertical separator -->
  <Style Selector="Border.topbar-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="Margin" Value="6,8" />
  </Style>

  <!-- ===== TextBox ===== -->

  <Style Selector="TextBox.connection-input">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
  </Style>

  <!-- ===== Badges ===== -->

  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge.badge-outline">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.badge.modified">
    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
  </Style>
  <Style Selector="Border.badge.modified TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimarySoftFgBrush}" />
  </Style>
  <Style Selector="Border.badge.only-source">
    <Setter Property="Background" Value="{StaticResource SecondarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
  </Style>
  <Style Selector="Border.badge.only-source TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondarySoftFgBrush}" />
  </Style>
  <Style Selector="Border.badge.only-target">
    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.badge.only-target TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarningFgBrush}" />
  </Style>
  <Style Selector="Border.badge.identical">
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
  </Style>
  <Style Selector="Border.badge.identical TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgSubtleBrush}" />
  </Style>

  <!-- ===== Alerts ===== -->

  <Style Selector="Border.alert">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.alert.alert-danger">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- ===== DataGrid overrides =====

       FluentTheme defaults paint selected rows with a strong accent fill and
       draw a 2px black focus rectangle around the active cell. Both clash
       with the DbDelta design system; remap them to the softer PrimarySoft
       token and hide the cell focus rectangle entirely (the colored row
       background is plenty of selection feedback). -->

  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource PrimarySoftBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource PrimarySoftBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{StaticResource FgStrongBrush}" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="DataGridCell:focus">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridCell:current">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>

</Styles>
